{
  "$schema": "https://unpkg.com/@changesets/config@4.0.1/schema.json",
  "changelog": [
    "@changesets/changelog-github",
    { "repo": "pradel/revive-st", "template": "\n\n- {summary} {ref}" }
  ],
  "commit": false,
  "fixed": [],
  "linked": [],
  "access": "restricted",
  "baseBranch": "main",
  "updateInternalDependencies": "patch",
  "privatePackages": { "version": true, "tag": true },
  "ignore": [
    "@revive-st/website",
    "@revive-st/design",
    "@revive-st/speaker-emulator",
    "@revive-st/release",
    "bose-api-speaker-client",
    "expo-bose-wifi"
  ]
}
