{
  "expo": {
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "app",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "ios": {
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Required to scan for your Bose speaker on WiFi.",
        "NSLocalNetworkUsageDescription": "Used to find and communicate with your Bose speaker on the local network."
      },
      "entitlements": {
        "com.apple.developer.networking.HotspotConfiguration": true
      },
      "bundleIdentifier": "app.revivest.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#208AEF"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "ACCESS_WIFI_STATE",
        "CHANGE_WIFI_STATE",
        "CHANGE_WIFI_MULTICAST_STATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_NETWORK_STATE",
        "CHANGE_NETWORK_STATE"
      ],
      "package": "app.revivest.app"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "react-native-wifi-reborn",
        {
          "fineLocationPermission": true
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 30,
            "usePrecompiledHeaders": true,
            "enableMinifyInReleaseBuilds": false
          }
        }
      ],
      "expo-font",
      "expo-dev-client",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d477700-2459-41df-8db2-f3c0e6f7ee52"
      }
    }
  }
}
